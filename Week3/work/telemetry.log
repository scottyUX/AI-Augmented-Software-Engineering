                                                                                       [ 72%]\\ntests/test_pricing.py .....                                                                                                                                                                [100%]\\n\\n======================================================================================= 18 passed in 0.02s =======================================================================================\\nProcess Group PGID: 7399\\n</untrusted_context>\"}}}],\"display\":{\"name\":\"Shell\",\"description\":\"python -m pytest\"},\"resultDisplay\":[[{\"text\":\"====================================================================================== test session starts =======================================================================================\",\"bold\":true,\"italic\":false,\"underline\":false,\"dim\":false,\"inverse\":false,\"isUninitialized\":false,\"fg\":\"\",\"bg\":\"\"}],[{\"text\":\"platform darwin -- Python 3.13.13, pytest-9.1.1, pluggy-1.7.0                                                                                                                                     \",\"bold\":false,\"italic\":false,\"underline\":false,\"dim\":false,\"inverse\":false,\"isUninitialized\":true,\"fg\":\"\",\"bg\":\"\"}],[{\"text\":\"rootdir: /Users/mohammadpoorahmadi/AI-Augmented-Software-Engineering/AI-Augmented-Software-Engineering/assignments/03-anatomy-of-coding-agents/gemini-cli-dissection/work/run                     \",\"bold\":false,\"italic\":false,\"underline\":false,\"dim\":false,\"inverse\":false,\"isUninitialized\":true,\"fg\":\"\",\"bg\":\"\"}],[{\"text\":\"collected 18 items                                                                                                                                                                               \",\"bold\":true,\"italic\":false,\"underline\":false,\"dim\":false,\"inverse\":false,\"isUninitialized\":true,\"fg\":\"\",\